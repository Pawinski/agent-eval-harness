#!/usr/bin/env bash
# git credential helper: answers only for github.com/Pawinski/agent-eval-harness(.git).
# Anything else is a hard stop (nonzero exit, no fallback to other helpers or tokens).
# Use with: git -c credential.helper= -c credential.helper=<this-script>
# and -c credential.useHttpPath=true so git sends the path.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
[ "${1:-}" = get ] || exit 0
host= path=
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case $k in
    host) host=$v ;;
    path) path=$v ;;
  esac
done
if [ "$host" != github.com ]; then
  echo "git-credential-glassrose-app: refused host (no fallback)" >&2
  exit 1
fi
case "$path" in
  Pawinski/agent-eval-harness|Pawinski/agent-eval-harness.git) ;;
  *)
    echo "git-credential-glassrose-app: refused path (no fallback)" >&2
    exit 1
    ;;
esac
tok=$("$here/glassrose-app-token") || { echo "git-credential-glassrose-app: App refused, stopping (no fallback)" >&2; exit 1; }
printf 'username=x-access-token\npassword=%s\n' "$tok"
