# OpenRouter-style multi-model LLM (required for live agent runs)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Pluggable model id (OpenRouter format)
MODEL=openai/gpt-4o-mini

# Optional: override API base (default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: max tokens per completion (default 512)
# MAX_TOKENS=512

# Optional: enable cache breakpoint (cache_control ephemeral on system message, default off)
# AGENT_EVAL_CACHE_BREAKPOINT=1
# Note: The previous variable name still works but prints a deprecation warning.
