{
  "name": "basilisk-eval",
  "version": "0.1.0",
  "description": "Public Basilisk eval harness (ReAct + MCP + multi-model LLM); frozen suite + deterministic pass/N.",
  "type": "module",
  "main": "dist/run.js",
  "scripts": {
    "build": "tsc",
    "start": "node --import tsx src/run.ts",
    "eval": "node --import tsx src/run.ts",
    "matrix": "node --import tsx src/matrix.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ban-scan": "node --import tsx src/tests/ban-scan.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "eval",
    "react-agent",
    "mcp",
    "openrouter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
